#!/bin/sh
# On every commit: bump the dev prerelease number in VERSION
# (0.0.0-dev.1 -> 0.0.0-dev.2), then regenerate the Swift constant that
# `render version` prints. Both changes are staged into the commit.
#
# VERSION is left as-is if it isn't of the form "<semver>-dev.<n>"
# (e.g. a tagged release version); the Swift constant still tracks it.

repo_root=$(git rev-parse --show-toplevel)
version_file="$repo_root/VERSION"
generated_swift="$repo_root/render/render/Version.swift"

[ -f "$version_file" ] || exit 0

current=$(cat "$version_file")

case "$current" in
    *-dev.*)
        base=${current%-dev.*}
        num=${current##*-dev.}
        case "$num" in
            ''|*[!0-9]*) ;;
            *)
                current="${base}-dev.$((num + 1))"
                printf '%s\n' "$current" > "$version_file"
                git add "$version_file"
                ;;
        esac
        ;;
esac

cat > "$generated_swift" <<EOF
// Generated by .githooks/pre-commit from the VERSION file. Do not edit by hand.
enum Version {
    static let current = "$current"
}
EOF
git add "$generated_swift"

exit 0
